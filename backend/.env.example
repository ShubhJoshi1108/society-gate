# Two names pointing to this server's IP (free: DuckDNS gives up to 5 names)
DOMAIN=mysociety.duckdns.org
PUSH_DOMAIN=mysociety-push.duckdns.org

# Minutes before an unanswered request is marked "No response" and the guard is alerted
EXPIRE_MINUTES=10

# Houses are created automatically, numbered 1 to HOUSE_COUNT
HOUSE_COUNT=400
